{
	"simple_to_index_controller": {
		"source_profile": "/interaction_profiles/khr/simple_controller",
		"target_profile": "/interaction_profiles/valve/index_controller",
		"helpers": [
			"/helper/controller/poses",
			"/helper/controller/output"
		],
		"bindings": {
