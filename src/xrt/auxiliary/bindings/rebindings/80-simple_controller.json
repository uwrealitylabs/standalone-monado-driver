			"/user/hand/right/input/select/click": "/user/hand/right/input/trigger/value"
		}
	},
	"simple_to_vive_controller": {
		"source_profile": "/interaction_profiles/khr/simple_controller",
		"target_profile": "/interaction_profiles/htc/vive_controller",
