{
	"mx_ink_stylus_logitech_to_motion_controller": {
		"source_profile": "/interaction_profiles/logitech/mx_ink_stylus_logitech",
		"target_profile": "/interaction_profiles/microsoft/motion_controller",
		"helpers": ["/helper/controller/output"],
		"bindings": {
			"/user/hand/left/input/aim": true,
			"/user/hand/left/input/aim/pose": true,
			"/user/hand/left/input/cluster_back_logitech": "/user/hand/left/input/trackpad",
			"/user/hand/left/input/cluster_back_logitech/click": "/user/hand/left/input/trackpad/click",
			"/user/hand/left/input/cluster_back_logitech/double_tap_logitech": "/user/hand/left/input/menu/click",
			"/user/hand/left/input/cluster_front_logitech": "/user/hand/left/input/squeeze",
			"/user/hand/left/input/cluster_front_logitech/click": "/user/hand/left/input/squeeze/click",
			"/user/hand/left/input/cluster_front_logitech/double_tap_logitech": "/user/hand/left/input/system/click",
			"/user/hand/left/input/cluster_middle_logitech/force": "/user/hand/left/input/trigger/value",
			"/user/hand/left/input/dock_logitech/docked_logitech": false,
			"/user/hand/left/input/grip": true,
			"/user/hand/left/input/grip/pose": true,
			"/user/hand/left/input/grip_surface": true,
			"/user/hand/left/input/grip_surface/pose": true,
			"/user/hand/left/input/pinch_ext": true,
			"/user/hand/left/input/pinch_ext/pose": true,
			"/user/hand/left/input/poke_ext": true,
			"/user/hand/left/input/poke_ext/pose": true,
			"/user/hand/left/input/system": false,
			"/user/hand/left/input/system/click": false,
			"/user/hand/left/input/tip_logitech": false,
			"/user/hand/left/input/tip_logitech/force": false,
			"/user/hand/left/input/tip_logitech/pose": false,
			"/user/hand/right/input/aim": true,
			"/user/hand/right/input/aim/pose": true,
			"/user/hand/right/input/cluster_back_logitech": "/user/hand/right/input/trackpad",
			"/user/hand/right/input/cluster_back_logitech/click": "/user/hand/right/input/trackpad/click",
			"/user/hand/right/input/cluster_back_logitech/double_tap_logitech": "/user/hand/right/input/menu/click",
			"/user/hand/right/input/cluster_front_logitech": "/user/hand/right/input/squeeze",
			"/user/hand/right/input/cluster_front_logitech/click": "/user/hand/right/input/squeeze/click",
			"/user/hand/right/input/cluster_front_logitech/double_tap_logitech": "/user/hand/right/input/system/click",
			"/user/hand/right/input/cluster_middle_logitech/force": "/user/hand/right/input/trigger/value",
			"/user/hand/right/input/dock_logitech/docked_logitech": false,
			"/user/hand/right/input/grip": true,
			"/user/hand/right/input/grip/pose": true,
			"/user/hand/right/input/grip_surface": true,
			"/user/hand/right/input/grip_surface/pose": true,
			"/user/hand/right/input/pinch_ext": true,
			"/user/hand/right/input/pinch_ext/pose": true,
			"/user/hand/right/input/poke_ext": true,
			"/user/hand/right/input/poke_ext/pose": true,
			"/user/hand/right/input/system": false,
			"/user/hand/right/input/system/click": false,
			"/user/hand/right/input/tip_logitech": false,
			"/user/hand/right/input/tip_logitech/force": false,
			"/user/hand/right/input/tip_logitech/pose": false
		}
	}
